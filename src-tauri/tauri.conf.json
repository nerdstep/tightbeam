{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tightbeam",
  "identifier": "chat.tightbeam.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tightbeam",
        "visible": false,
        "width": 440,
        "height": 680,
        "minWidth": 340,
        "minHeight": 420,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: tbfile: http://tbfile.localhost",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: tbfile: http://tbfile.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxODlGODBEQzA4RkI0QTEKUldTaHRJL0FEZmlKY1pHdUI0VEFoa045elFjQ2tjcExIbXlhcTlqSEhMN3l2Z282dGxSZDVMQTgK",
      "endpoints": ["https://github.com/nerdstep/tightbeam/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "category": "SocialNetworking",
    "shortDescription": "Private chat between two people on the same network",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installerHooks": "windows/hooks.nsh" }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
